---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
---

<Base title="Experiments" description="Zeke Wattles - Graphic Design and Art Direction">
  <div class="container">
    <div class="row">
      <div class="col-lg mx-auto">
        <div class="post-header">
          <h1>Experiments</h1>
        </div>

        <div class="row">
          <div class="col-lg">
            <article class="post-preview">
              <a href="/kinetic-type/" target="_blank" rel="noopener">
                <img src="/img/experiments/kinetic4.gif" class="img-fluid" />
                <p class="post-title">
                  <strong>Kinetic Type</strong>
                </p>
              </a>
              <p style="text-align: center">
                Adventures in kinetic typography on the web with sine waves and
                p5js. With <a
                  href="http://alitorbati.com/"
                  target="_blank"
                  rel="noopener">Ali Torbati</a
                >.
              </p>
            </article>
            <br /><br />
          </div>
        </div>

        <Footer />
      </div>
    </div>
  </div>
</Base>
